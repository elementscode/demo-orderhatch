import "./style.css";
import { LiveView } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { money } from "#app/shared/format";
import { Category, MenuItem, OptionGroup, isSoldOut, itemsIn } from "#app/shared/menu";
import { PHOTOS, photoUrl } from "#app/shared/photos";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogFooter } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { Textarea } from "@elements/ui/textarea";

interface GroupToggle {
  id: string;
  name: string;
  on: boolean;
}

/** The row being edited, as a buffer so half-typed changes never reach customers. */
interface Draft {
  id: string;
  name: string;
  description: string;
  price: string;
  categoryId: string;
  photo: string;
  hidden: boolean;
  groups: GroupToggle[];
  error: string;
}

function emptyDraft(): Draft {
  return { id: "", name: "", description: "", price: "", categoryId: "", photo: "", hidden: false, groups: [], error: "" };
}

function photoChoices(): { id: string; label: string }[] {
  return Object.keys(PHOTOS).map((key) => ({ id: key, label: key.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase()) }));
}

function onEdit(draft: Draft, item: MenuItem, groups: OptionGroup[]) {
  Object.assign(draft, {
    id: item.id,
    name: item.name,
    description: item.description,
    price: (item.priceCents / 100).toFixed(2),
    categoryId: item.categoryId,
    photo: item.photo,
    hidden: item.hidden,
    groups: groups.map((g) => ({ id: g.id, name: g.name, on: item.optionGroupIds.includes(g.id) })),
    error: "",
  });
}

function onCancel(draft: Draft) {
  draft.id = "";
}

function onSave(menu: LiveView<MenuItem>, draft: Draft, item: MenuItem) {
  let cents = Math.round(Number(draft.price) * 100);

  if (!draft.name.trim()) {
    draft.error = "Give the item a name.";
    return;
  }

  if (!Number.isFinite(cents) || cents < 0) {
    draft.error = "Enter a price like 10.50.";
    return;
  }

  menu.update({
    ...item,
    name: draft.name.trim(),
    description: draft.description.trim(),
    priceCents: cents,
    categoryId: draft.categoryId,
    photo: draft.photo,
    hidden: draft.hidden,
    optionGroupIds: draft.groups.filter((g) => g.on).map((g) => g.id),
  }, () => draft.id = "");
}

function onAddItem(menu: LiveView<MenuItem>, draft: Draft, category: Category, groups: OptionGroup[]) {
  let last = itemsIn(menu, category.id, true).at(-1);
  let item = menu.insert({
    categoryId: category.id,
    name: "New item",
    description: "",
    priceCents: 0,
    photo: "",
    optionGroupIds: [],
    hidden: true,
    soldOutUntil: null,
    position: (last?.position ?? 0) + 1,
    createdAt: new Date(),
  });

  onEdit(draft, item, groups);
}

function onDelete(menu: LiveView<MenuItem>, draft: Draft, item: MenuItem) {
  draft.id = "";
  menu.delete(item);
}

<html lang="en" class="page-admin-menu" (
  menu: LiveView<MenuItem>,
  categories: Category[],
  groups: OptionGroup[],
  private draft: Draft = emptyDraft(),
)>
  <head>
    <title>Menu · orderhatch</title>
    <meta name="description" content="Edit the menu.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout section="admin-menu">
      <div class="menu-admin page-shell stack is-lg">
        <div class="menu-admin-head stack is-xs">
          <h1>Menu</h1>
          <p>Changes go live on the order page as soon as you save. New items start hidden until you're ready.</p>
        </div>

        <Card e:for={category of categories} title={category.name} level={2}>
          <Button slot="action" size="sm" onclick={() => onAddItem(menu, draft, category, groups)}>Add item</Button>

          <ul class="menu-rows">
            <li e:for={item of itemsIn(menu, category.id, true)} class={["menu-row", item.hidden && "is-hidden"]}>
              <img e:if={photoUrl(item.photo)} src={photoUrl(item.photo)} alt="" width="56" height="42">
              <span e:else class="thumb"></span>

              <div>
                <div class="menu-row-name">{item.name}</div>
                <div class="menu-row-desc line-clamp-1">{item.description}</div>
              </div>

              <div class="cluster is-xs">
                <Badge e:if={item.hidden} variant="secondary">Hidden</Badge>
                <Badge e:if={isSoldOut(item)} variant="danger">Sold out today</Badge>
                <span class="menu-row-price">{money(item.priceCents)}</span>
              </div>

              <Button size="sm" variant="ghost" onclick={() => draft.id === item.id ? onCancel(draft) : onEdit(draft, item, groups)}>
                {draft.id === item.id ? "Close" : "Edit"}
              </Button>

              <form e:if={draft.id === item.id} class="editor stack" onsubmit={() => onSave(menu, draft, item)}>
                <Alert e:if={draft.error} variant="danger" description={draft.error} />

                <div class="editor-grid">
                  <div class="stack">
                    <Field label="Name" required>
                      <Input value={draft.name} />
                    </Field>

                    <Field label="Description">
                      <Textarea rows={2} value={draft.description} />
                    </Field>

                    <div class="row is-start" style="gap: var(--space-4)">
                      <Field label="Price ($)" required>
                        <Input value={draft.price} attrs={{ inputmode: "decimal" }} />
                      </Field>

                      <Field label="Category">
                        <NativeSelect value={draft.categoryId} options={categories.map((c) => ({ value: c.id, label: c.name }))} />
                      </Field>
                    </div>

                    <Field label="Options customers choose">
                      <div class="editor-groups cluster">
                        <label e:for={g of draft.groups}>
                          <Checkbox checked={g.on} />
                          {g.name}
                        </label>
                      </div>
                    </Field>

                    <label class="row is-start text-sm" style="gap: var(--space-2)">
                      <Checkbox checked={draft.hidden} />
                      Hide from the order page
                    </label>
                  </div>

                  <div class="stack is-sm">
                    <img e:if={photoUrl(draft.photo)} class="editor-photo" src={photoUrl(draft.photo)} alt="" width="240" height="180">
                    <span e:else class="editor-photo"></span>
                    <Field label="Photo">
                      <NativeSelect value={draft.photo} block options={[{ value: "", label: "No photo" }, ...photoChoices().map((c) => ({ value: c.id, label: c.label }))]} />
                    </Field>
                  </div>
                </div>

                <div class="editor-foot row">
                  <AlertDialog title={`Delete ${item.name} from the menu?`} description="Past orders keep their line items.">
                    <Button slot="trigger" variant="danger" size="sm">Delete item</Button>
                    <AlertDialogFooter>
                      <AlertDialogCancel>Cancel</AlertDialogCancel>
                      <AlertDialogAction variant="danger" onclick={() => onDelete(menu, draft, item)}>Delete</AlertDialogAction>
                    </AlertDialogFooter>
                  </AlertDialog>
                  <div class="cluster is-sm">
                    <Button variant="ghost" onclick={() => onCancel(draft)}>Cancel</Button>
                    <Button type="submit" variant="primary">Save</Button>
                  </div>
                </div>
              </form>
            </li>
          </ul>
        </Card>
      </div>
    </Layout>
  </body>
</html>
