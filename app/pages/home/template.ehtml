import "./style.css";
import { FieldErrors, LiveView, redirect } from "@elements/app";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { money, taxFor } from "#app/shared/format";
import { Category, MenuItem, OptionGroup, groupsFor, isSoldOut, itemsIn } from "#app/shared/menu";
import { photoUrl } from "#app/shared/photos";
import { Choice, choiceSummary } from "#app/shared/tickets";
import type { Schedule } from "#app/shared/services/hours";
import { OrderForm, placeOrder } from "#app/shared/services/checkout";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Dialog, DialogBody } from "@elements/ui/dialog";
import { Empty } from "@elements/ui/empty";
import { Field, FieldContent, FieldLabel, FieldLegend, FieldSet, FieldTitle } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";
import { Sheet, SheetBody } from "@elements/ui/sheet";

interface CartLine {
  id: string;
  itemId: string;
  name: string;
  photo: string;
  quantity: number;
  optionIds: string[];
  choices: Choice[];
  unitCents: number;
}

interface Cart {
  lines: CartLine[];
  open: boolean;
  step: string;
}

interface PickOption {
  id: string;
  name: string;
  priceCents: number;
  picked: boolean;
}

interface PickGroup {
  id: string;
  name: string;
  kind: string;
  required: boolean;
  /** The picked option of a choose-one group. */
  chosen: string;
  options: PickOption[];
}

/** The dish being customized, with a copy of its option groups to pick in. */
interface Picker {
  open: boolean;
  item: MenuItem | null;
  groups: PickGroup[];
  quantity: number;
}

interface Details {
  name: string;
  phone: string;
  email: string;
  mode: string;
  slot: string;
  errors: FieldErrors<OrderForm>;
  error: string;
  busy: boolean;
}

const CART_KEY = "orderhatch-cart";

function subtotal(cart: Cart): number {
  return cart.lines.reduce((sum, l) => sum + l.unitCents * l.quantity, 0);
}

function count(cart: Cart): number {
  return cart.lines.reduce((sum, l) => sum + l.quantity, 0);
}

function lineSoldOut(menu: LiveView<MenuItem>, line: CartLine): boolean {
  let item = menu.get(line.itemId);

  return !item || item.hidden || isSoldOut(item);
}

function cartBlocked(menu: LiveView<MenuItem>, cart: Cart): boolean {
  return cart.lines.some((l) => lineSoldOut(menu, l));
}

function saveCart(cart: Cart) {
  localStorage.setItem(CART_KEY, JSON.stringify(cart.lines));
}

function onLoadCart(cart: Cart) {
  try {
    let saved = JSON.parse(localStorage.getItem(CART_KEY) ?? "[]");

    if (Array.isArray(saved)) {
      cart.lines = saved;
    }
  } catch {
    localStorage.removeItem(CART_KEY);
  }
}

function isPicked(group: PickGroup, option: PickOption): boolean {
  return group.kind === "one" ? group.chosen === option.id : option.picked;
}

function pickedOptions(picker: Picker): { ids: string[]; choices: Choice[] } {
  let ids: string[] = [];
  let choices: Choice[] = [];

  for (let group of picker.groups) {
    for (let option of group.options.filter((o) => isPicked(group, o))) {
      ids.push(option.id);
      choices.push({ group: group.name, name: option.name, priceCents: option.priceCents });
    }
  }

  return { ids, choices };
}

function pickerUnit(picker: Picker): number {
  if (!picker.item) {
    return 0;
  }

  return picker.item.priceCents + pickedOptions(picker).choices.reduce((sum, c) => sum + c.priceCents, 0);
}

function missingChoice(picker: Picker): string {
  let group = picker.groups.find((g) => g.required && !g.options.some((o) => isPicked(g, o)));

  return group ? group.name : "";
}

function extra(cents: number): string {
  return cents > 0 ? `+${money(cents)}` : "";
}

function onPick(picker: Picker, item: MenuItem, groups: OptionGroup[]) {
  picker.groups = groupsFor(item, groups).map((g) => ({
    id: g.id,
    name: g.name,
    kind: g.kind,
    required: g.required,
    chosen: g.kind === "one" && g.required ? g.options[0]?.id ?? "" : "",
    options: g.options.map((o) => ({ ...o, picked: false })),
  }));
  picker.quantity = 1;
  picker.item = item;
  picker.open = true;
}

function onAdd(picker: Picker, cart: Cart) {
  let item = picker.item;

  if (!item || missingChoice(picker)) {
    return;
  }

  let { ids, choices } = pickedOptions(picker);
  let key = `${item.id}:${[...ids].sort().join(",")}`;
  let same = cart.lines.find((l) => l.id === key);

  if (same) {
    same.quantity += picker.quantity;
  } else {
    cart.lines.push({
      id: key,
      itemId: item.id,
      name: item.name,
      photo: item.photo,
      quantity: picker.quantity,
      optionIds: ids,
      choices,
      unitCents: pickerUnit(picker),
    });
  }

  saveCart(cart);
  picker.open = false;
}

function onQuantity(cart: Cart, line: CartLine, delta: number) {
  line.quantity = Math.max(0, Math.min(20, line.quantity + delta));

  if (line.quantity === 0) {
    cart.lines = cart.lines.filter((l) => l.id !== line.id);
  }

  if (cart.lines.length === 0) {
    cart.step = "cart";
  }

  saveCart(cart);
}

async function onPay(cart: Cart, details: Details) {
  details.busy = true;
  details.error = "";
  details.errors = {};

  try {
    let url = await placeOrder({
      name: details.name,
      phone: details.phone,
      email: details.email,
      pickup: details.mode === "asap" ? "asap" : details.slot,
      lines: cart.lines.map((l) => ({ itemId: l.itemId, quantity: l.quantity, optionIds: l.optionIds })),
    });

    localStorage.removeItem(CART_KEY);
    redirect(url);
  } catch (err: any) {
    details.errors = err.errors ?? {};
    details.error = err.errors ? "" : err.message;
    details.busy = false;
  }
}

<html lang="en" class="page-menu" (
  menu: LiveView<MenuItem>,
  categories: Category[],
  groups: OptionGroup[],
  schedule: Schedule,
  testMode: boolean,
  private cart: Cart = { lines: [], open: false, step: "cart" },
  private picker: Picker = { open: false, item: null, groups: [], quantity: 1 },
  private details: Details = {
    name: "",
    phone: "",
    email: "",
    mode: schedule.asap ? "asap" : "later",
    slot: schedule.slots[0]?.value ?? "",
    errors: {},
    error: "",
    busy: false,
  },
) oninit={() => onLoadCart(cart)}>
  <head>
    <title>{config.restaurant.name} · Order pickup</title>
    <meta name="description" content={`Order tacos, burritos and more from ${config.restaurant.name} for pickup.`}>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout section="menu">
      <section class="menu-hero">
        <div class="menu-hero-inner stack is-md">
          <p class="eyebrow">Order ahead · pickup at the window</p>
          <h1>{config.restaurant.name}</h1>
          <p>Tortillas pressed to order, salsas made every morning. Order here, pay by card, and watch your order go from the grill to the window.</p>
          <div class="menu-hero-meta cluster is-sm">
            <Badge e:if={schedule.asap} variant="success" dot>Open now · ready in about {config.restaurant.leadMinutes} min</Badge>
            <Badge e:elseif={schedule.slots.length > 0} variant="warning" dot>Taking orders for later today</Badge>
            <Badge e:else variant="danger" dot>Not taking orders right now</Badge>
            <span>{schedule.label}</span>
            <span>{config.restaurant.address}</span>
          </div>
        </div>
      </section>

      <div class="menu-layout">
        <div>
          <nav class="menu-nav cluster is-xs" aria-label="Menu sections">
            <a e:for={category of categories} href={`#cat-${category.id}`}>{category.name}</a>
          </nav>

          <section e:for={category of categories} id={`cat-${category.id}`} class="menu-category">
            <div class="menu-category-head stack is-xs">
              <h2>{category.name}</h2>
              <p>{category.blurb}</p>
            </div>

            <div class="menu-grid">
              <button e:for={item of itemsIn(menu, category.id)}
                      type="button"
                      class="dish"
                      disabled={isSoldOut(item)}
                      aria-label={isSoldOut(item) ? `${item.name}, sold out today` : `Add ${item.name}, ${money(item.priceCents)}`}
                      onclick={() => onPick(picker, item, groups)}>
                <div class="dish-photo">
                  <img e:if={photoUrl(item.photo)} src={photoUrl(item.photo)} alt="" loading="lazy" width="400" height="300">
                  <Badge e:if={isSoldOut(item)} variant="danger" class="dish-soldout">Sold out today</Badge>
                </div>
                <div class="dish-body">
                  <div class="dish-title row">
                    <strong>{item.name}</strong>
                    <span class="dish-price">{money(item.priceCents)}</span>
                  </div>
                  <p class="dish-desc line-clamp-2">{item.description}</p>
                </div>
                <span e:if={!isSoldOut(item)} class="dish-add" aria-hidden="true">+</span>
              </button>
            </div>
          </section>
        </div>

        <aside class="cart" aria-label="Your order">
          <Card title={cart.step === "cart" ? "Your order" : "Pickup details"} level={2}>
            <CardAction slot="action"><Button e:if={cart.step === "details"} variant="ghost" size="sm" onclick={() => cart.step = "cart"}>Back</Button></CardAction>
            <CardContent class="stack">
              <CartBody menu={menu} schedule={schedule} testMode={testMode} cart={cart} details={details} />
            </CardContent>
          </Card>
        </aside>
      </div>

      <Button e:if={cart.lines.length > 0 && !cart.open}
              variant="primary"
              size="lg"
              class="cart-bar"
              onclick={() => cart.open = true}>
        <span>View order · {count(cart)} {count(cart) === 1 ? "item" : "items"}</span>
        <span>{money(subtotal(cart))}</span>
      </Button>

      <Sheet open={cart.open} side="bottom" title={cart.step === "cart" ? "Your order" : "Pickup details"}>
        <SheetBody>
          <div e:if={cart.step === "details"}>
            <Button variant="link" size="sm" onclick={() => cart.step = "cart"}>Back</Button>
          </div>
          <CartBody menu={menu} schedule={schedule} testMode={testMode} cart={cart} details={details} />
        </SheetBody>
      </Sheet>

      <Dialog open={picker.open} label={picker.item?.name ?? ""} scroll="inside" class="dish-dialog">
        <DialogBody>
          <div class="dish-dialog-photo">
            <img e:if={photoUrl(picker.item?.photo ?? "")} src={photoUrl(picker.item?.photo ?? "")} alt="" width="544" height="306">
          </div>

          <div class="dish-dialog-body stack is-lg">
            <div class="stack is-xs">
              <h2>{picker.item?.name}</h2>
              <p class="hint">{picker.item?.description}</p>
              <strong>{money(picker.item?.priceCents ?? 0)}</strong>
            </div>

            <FieldSet e:for={group of picker.groups}>
              <FieldLegend class="dish-group-legend">
                {group.name}
                <small e:if={group.kind === "one" && group.required}>Choose one</small>
                <small e:elseif={group.kind === "many"}>Optional, choose any</small>
              </FieldLegend>
              <RadioGroup e:if={group.kind === "one"} value={group.chosen} class="choices" attrs={{ "aria-label": group.name }}>
                <FieldLabel e:for={option of group.options}>
                  <Field orientation="horizontal" reserveError={false}>
                    <RadioGroupItem value={option.id} />
                    <FieldContent><FieldTitle>{option.name}</FieldTitle></FieldContent>
                    <small class="choice-price">{extra(option.priceCents)}</small>
                  </Field>
                </FieldLabel>
              </RadioGroup>
              <div e:else class="choices">
                <FieldLabel e:for={option of group.options}>
                  <Field orientation="horizontal" reserveError={false}>
                    <Checkbox checked={option.picked} />
                    <FieldContent><FieldTitle>{option.name}</FieldTitle></FieldContent>
                    <small class="choice-price">{extra(option.priceCents)}</small>
                  </Field>
                </FieldLabel>
              </div>
            </FieldSet>
          </div>
        </DialogBody>

        <div class="dish-foot row">
          <div class="stepper row" aria-label="Quantity">
            <Button size="sm" icon round label="One less" disabled={picker.quantity <= 1} onclick={() => picker.quantity = Math.max(1, picker.quantity - 1)}><Icon name="minus" /></Button>
            <span>{picker.quantity}</span>
            <Button size="sm" icon round label="One more" onclick={() => picker.quantity = Math.min(20, picker.quantity + 1)}><Icon name="plus" /></Button>
          </div>
          <Button variant="primary" size="lg" disabled={missingChoice(picker) !== ""} onclick={() => onAdd(picker, cart)}>
            Add to order · {money(pickerUnit(picker) * picker.quantity)}
          </Button>
        </div>
      </Dialog>
    </Layout>
  </body>
</html>

<CartBody (
  menu: LiveView<MenuItem>,
  schedule: Schedule,
  testMode: boolean,
  cart: Cart,
  details: Details,
)>
  <Empty e:if={cart.lines.length === 0} description="Nothing here yet. Tap a dish to add it." />

  <ul e:if={cart.step === "cart" && cart.lines.length > 0} class="cart-lines">
    <li e:for={line of cart.lines} class="cart-line">
      <img e:if={photoUrl(line.photo)} src={photoUrl(line.photo)} alt="" width="48" height="48">
      <span e:else class="cart-thumb"></span>
      <div>
        <div class="cart-line-name">{line.name}</div>
        <div e:if={line.choices.length > 0} class="cart-line-choices">{choiceSummary(line.choices)}</div>
        <p e:if={lineSoldOut(menu, line)} class="error">Sold out for today. Remove it to check out.</p>
        <div class="stepper row">
          <Button size="xs" icon round label={`One less ${line.name}`} onclick={() => onQuantity(cart, line, -1)}><Icon name="minus" /></Button>
          <span>{line.quantity}</span>
          <Button size="xs" icon round label={`One more ${line.name}`} onclick={() => onQuantity(cart, line, 1)}><Icon name="plus" /></Button>
        </div>
      </div>
      <span class="cart-line-price">{money(line.unitCents * line.quantity)}</span>
    </li>
  </ul>

  <form e:if={cart.step === "details" && cart.lines.length > 0} class="stack" onsubmit={() => onPay(cart, details)}>
    <Alert e:if={details.error} variant="danger" description={details.error} />

    <Field label="Name for the order" required error={details.errors.name?.[0] ?? ""}>
      <Input name="name" value={details.name} attrs={{ autocomplete: "name" }} />
    </Field>

    <Field label="Phone" required error={details.errors.phone?.[0] ?? ""}>
      <Input name="phone" type="tel" value={details.phone} placeholder="(323) 555-0123" attrs={{ autocomplete: "tel" }} />
    </Field>

    <Field label="Email for your receipt" required error={details.errors.email?.[0] ?? ""}>
      <Input name="email" type="email" value={details.email} attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
    </Field>

    <FieldSet>
      <FieldLegend variant="label">Pickup time</FieldLegend>
      <RadioGroup value={details.mode} class="choices" attrs={{ "aria-label": "Pickup time" }}>
        <FieldLabel>
          <Field orientation="horizontal" reserveError={false}>
            <RadioGroupItem value="asap" disabled={!schedule.asap} />
            <FieldContent><FieldTitle>ASAP, ~{config.restaurant.leadMinutes} min</FieldTitle></FieldContent>
          </Field>
        </FieldLabel>
        <FieldLabel>
          <Field orientation="horizontal" reserveError={false}>
            <RadioGroupItem value="later" disabled={schedule.slots.length === 0} />
            <FieldContent><FieldTitle>Later today</FieldTitle></FieldContent>
          </Field>
        </FieldLabel>
      </RadioGroup>
      <Field e:if={details.mode === "later"} error={details.errors.pickup?.[0] ?? ""} reserveError={false}>
        <NativeSelect value={details.slot} block options={schedule.slots.map((s) => ({ value: s.value, label: s.label }))} attrs={{ "aria-label": "Pickup time" }} />
      </Field>
      <p e:elseif={details.errors.pickup} class="error">{details.errors.pickup?.[0]}</p>
    </FieldSet>

    <Button type="submit" variant="primary" size="lg" block loading={details.busy} disabled={cartBlocked(menu, cart)}>
      Pay {money(subtotal(cart) + taxFor(subtotal(cart)))}
    </Button>
    <p e:if={testMode} class="hint">Test mode: you'll pay on the app's test checkout, no card needed, then come back here to follow your order.</p>
    <p e:else class="hint">You'll pay on Stripe's secure checkout, then come back here to follow your order.</p>
  </form>

  <dl e:if={cart.lines.length > 0} class="totals">
    <dt>Subtotal</dt>
    <dd>{money(subtotal(cart))}</dd>
    <dt>Tax</dt>
    <dd>{money(taxFor(subtotal(cart)))}</dd>
    <dt class="is-total">Total</dt>
    <dd class="is-total">{money(subtotal(cart) + taxFor(subtotal(cart)))}</dd>
  </dl>

  <div e:if={cart.step === "cart" && cart.lines.length > 0} class="stack is-sm">
    <Button e:if={schedule.asap || schedule.slots.length > 0}
            variant="primary"
            size="lg"
            block
            disabled={cartBlocked(menu, cart)}
            onclick={() => cart.step = "details"}>
      Check out
    </Button>
    <Alert e:else variant="warning" role="none" description={`We're not taking orders right now. ${schedule.label}.`} />
  </div>
</CartBody>
