import "./style.css";
import { sql, ValidationError } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { requireOwner } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { TimePicker } from "@elements/ui/time-picker";
import { toast } from "@elements/ui/toast";

export interface Day {
  id: string;
  weekday: number;
  opensAt: string;
  closesAt: string;
  closed: boolean;
}

const NAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

/** Monday first, the way a posted sign reads. */
export function loadHours(): Day[] {
  return sql<Day>(`
    select id, weekday, to_char(opensAt, 'HH24:MI') as opensAt, to_char(closesAt, 'HH24:MI') as closesAt, closed
      from hours
     order by (weekday + 6) % 7
  `).all();
}

/** @rpc */
export function saveHours(days: Day[]): Day[] {
  requireOwner();

  for (let day of days) {
    if (!day.closed && day.opensAt >= day.closesAt) {
      throw new ValidationError(`${NAMES[day.weekday]} has to close after it opens.`);
    }
  }

  for (let day of days) {
    sql(`
      update hours set opensAt = ${day.opensAt}::time, closesAt = ${day.closesAt}::time, closed = ${day.closed}
       where weekday = ${day.weekday}
    `);
  }

  return loadHours();
}

function onSave(days: Day[], state: { error: string; saved: boolean; busy: boolean }): Day[] {
  state.busy = true;
  state.saved = false;
  state.error = "";

  try {
    let fresh = saveHours(days);
    state.saved = true;
    toast.success("Saved. The order page uses the new hours now.");

    return fresh;
  } catch (err: any) {
    state.error = err.message;

    return days;
  } finally {
    state.busy = false;
  }
}

<html lang="en" class="page-admin-hours" (
  days: Day[],
  private state: { error: string; saved: boolean; busy: boolean } = { error: "", saved: false, busy: false },
)>
  <head>
    <title>Hours · orderhatch</title>
    <meta name="description" content="Opening hours.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout section="hours">
      <form class="hours page-shell is-form stack is-lg" onsubmit={() => days = onSave(days, state)}>
        <div class="hours-head stack is-xs">
          <h1>Hours</h1>
          <p>Customers can order ASAP while you're open, and schedule pickups for later the same day. The last pickup slot is 15 minutes before closing.</p>
        </div>

        <Alert e:if={state.error} variant="danger" description={state.error} />

        <Card>
          <CardContent>
            <Table class="hours-table">
              <table>
                <thead>
                  <tr>
                    <TableHead>Day</TableHead>
                    <TableHead>Opens</TableHead>
                    <TableHead>Closes</TableHead>
                    <TableHead><span class="sr-only">Closed</span></TableHead>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={day of days}>
                    <TableCell>{NAMES[day.weekday]}</TableCell>
                    <TableCell><TimePicker value={day.opensAt} disabled={day.closed} label={`${NAMES[day.weekday]} opens`} onValueChange={() => state.saved = false} /></TableCell>
                    <TableCell><TimePicker value={day.closesAt} disabled={day.closed} label={`${NAMES[day.weekday]} closes`} onValueChange={() => state.saved = false} /></TableCell>
                    <TableCell>
                      <label class="hours-closed">
                        <Checkbox checked={day.closed} onCheckedChange={() => state.saved = false} />
                        Closed
                      </label>
                    </TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>
          </CardContent>
        </Card>

        <div class="hours-foot row">
          <Button type="submit" variant="primary" loading={state.busy}>Save hours</Button>
        </div>
      </form>
    </Layout>
  </body>
</html>
